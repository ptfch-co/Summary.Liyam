@model Summary.Liyam.LiyamSettings

<div class="row">
  <div class="col-md-3">
    <div class="form-group">
      <label asp-for="ApiAddress">آدرس وب سرویس:</label>
      <input class="form-control" type="text" asp-for="ApiAddress" placeholder="https://app.samyarcloud2.ir" />
      <span class="hint">آدرس حسابداری را در این قسمت وارد کنید. مثال: https://app.samyarcloud2.ir</span>
    </div>
  </div>
  <div class="col-md-3">
    <div class="form-group">
      <label asp-for="Username">نام کاربری</label>
      <input class="form-control" type="text" asp-for="Username" />
      <span class="hint">لطفاً نام کاربری‌ای را که با آن وارد حسابداری لیام می‌شوید، وارد کنید.</span>
    </div>
  </div>
  <div class="col-md-3">
    <div class="form-group">
      <label asp-for="Password">گذرواژه</label>
      <input class="form-control" type="text" asp-for="Password" />
      <span class="hint">لطفاً گذرواژه‌ای را که با آن وارد حسابداری لیام می‌شوید، وارد کنید.</span>
    </div>
  </div>
  <div class="col-md-3">
    <div class="form-group">
      <label asp-for="AppKey">کلید برنامه:</label>
      <input class="form-control" type="text" asp-for="AppKey" placeholder="77cf8e84-68e2-4747-a494-fb2f6f96fda8" />
      <span class="hint">کلید برنامه را در این قسمت وارد کنید. مثال: 77cf8e84-68e2-4747-a494-fb2f6f96fda8 </span>
    </div>
  </div>
</div>